{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": [
			"ES2023"
		],
		"outDir": "out",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [
			"node",
			"vscode",
			"vitest/globals"
		]
	},
	"include": [
		"src/**/*.ts",
		"vitest.setup.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"out"
	]
}
