{
	"name": "copilot-pii-guard",
	"displayName": "PII Guard for Copilot",
	"description": "Copilot へ送る前に、氏名・社名・連絡先などを伏せ字へ置き換えます。",
	"version": "0.2.4",
	"publisher": "internal",
	"private": true,
	"license": "Apache-2.0",
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=20"
	},
	"categories": [
		"Chat",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"chatParticipants": [
			{
				"id": "pii-guard.mask",
				"name": "mask",
				"fullName": "PII Guard",
				"description": "伏せてから Copilot へ送ります",
				"isSticky": true
			}
		],
		"configuration": {
			"title": "PII Guard",
			"properties": {
				"piiGuard.enabled": {
					"type": "boolean",
					"default": true,
					"description": "@mask へ送る文を伏せ字へ置き換えます。"
				},
				"piiGuard.restore": {
					"type": "boolean",
					"default": true,
					"description": "応答の伏せ字を元の値へ戻して表示します。切ると {{person-001}} のまま表示します。"
				},
				"piiGuard.fileWrites.restore": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "**Write Restore モード。** `@mask` のファイル道具が書く内容を、ローカルで元の値へ戻します。切なら伏せ字のまま書きます。各回答の先頭に現在のモードを表示します。"
				},
				"piiGuard.kinds": {
					"type": "object",
					"markdownDescription": "基本検出・辞書・固有名詞検出に共通する、最終的な伏せ字の種類。外した種類は、どの方式で見つけてもそのまま送られます。",
					"additionalProperties": false,
					"default": {
						"person": true,
						"org": true,
						"term": true,
						"email": true,
						"phone": true,
						"host": true,
						"ip": true,
						"card": true,
						"secret": true,
						"zip": true,
						"address": true,
						"mynumber": true
					},
					"properties": {
						"person": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "辞書に書いた氏名。前後の文から推測するのは固有名詞検出"
						},
						"org": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "辞書に書いた社名・団体名。前後の文から推測するのは固有名詞検出"
						},
						"term": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "辞書に書いた、種類を決めていない語（案件コード、社員番号など）"
						},
						"email": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "メールアドレス"
						},
						"phone": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "電話番号（日本の形）"
						},
						"host": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "社内向けの宛先（`.local` `.internal` などで終わる名前）"
						},
						"ip": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "外向けの IP アドレス。社内向けと `localhost` は伏せない"
						},
						"card": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "クレジットカード番号。検査数字が合うものだけ"
						},
						"secret": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "API 鍵・token・パスワード。`AKIA…` のような形と、ラベルの付いた値"
						},
						"zip": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "郵便番号。`〒` か「郵便番号」の語が前にあるときだけ"
						},
						"address": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "住所。都道府県か市区町村から始まり、番地を含む並び"
						},
						"mynumber": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "マイナンバー。検査数字が合うものだけ"
						}
					}
				},
				"piiGuard.terms": {
					"type": "array",
					"default": [],
					"description": "必ず伏せる語。完全一致なので取りこぼしません。",
					"items": {
						"type": "object",
						"properties": {
							"value": {
								"type": "string"
							},
							"kind": {
								"type": "string",
								"enum": [
									"person",
									"org",
									"term"
								]
							},
							"regex": {
								"type": "boolean",
								"description": "真なら value を正規表現として扱います。"
							}
						},
						"required": [
							"value"
						]
					}
				},
				"piiGuard.dictionaryPaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "辞書のファイル。空なら ~/.agent/pii-dictionary.txt を見ます。"
				},
				"piiGuard.secretLabels": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "鍵のラベルに足す語。社内で使う語を並べます。"
				},
				"piiGuard.properNouns.enabled": {
					"type": "boolean",
					"default": false,
					"description": "固有名詞検出を使います。モデルのファイルを別に置く必要があります。"
				},
				"piiGuard.properNouns.entities": {
					"type": "object",
					"markdownDescription": "固有名詞検出モデルが返す区分のうち、採用するもの。対応する `piiGuard.kinds` も入のときだけ伏せます。",
					"additionalProperties": false,
					"default": {
						"PER": true,
						"ORG": true,
						"ORG-P": true,
						"ORG-O": true,
						"LOC": true,
						"INS": true,
						"PRD": false,
						"EVT": false
					},
					"properties": {
						"PER": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "人名"
						},
						"ORG": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "会社・団体などの一般的な組織名"
						},
						"ORG-P": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "政党・政府などの政治的な組織名"
						},
						"ORG-O": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "ほかの区分に当てはまらない組織名"
						},
						"LOC": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "国、都道府県、市区町村などの地名"
						},
						"INS": {
							"type": "boolean",
							"default": true,
							"markdownDescription": "駅、学校、病院、建物などの施設名"
						},
						"PRD": {
							"type": "boolean",
							"default": false,
							"markdownDescription": "製品名。**入れると技術の話が読めなくなる**"
						},
						"EVT": {
							"type": "boolean",
							"default": false,
							"markdownDescription": "大会、会議、祭典などのイベント名"
						}
					}
				},
				"piiGuard.properNouns.minScore": {
					"type": "number",
					"default": 0.9,
					"minimum": 0,
					"maximum": 1,
					"description": "確度の下限。下げると誤検出が入ります。誤検出は取りこぼしより害が大きいものです。"
				},
				"piiGuard.properNouns.timeBudgetMs": {
					"type": "number",
					"default": 10000,
					"minimum": 0,
					"description": "判定にかけてよい時間（ミリ秒）。0 と書くと、終わるまで待ちます。"
				},
				"piiGuard.properNouns.retryCount": {
					"type": "integer",
					"default": 3,
					"minimum": 0,
					"maximum": 10,
					"description": "時間切れまたは一時的な失敗のあとに再試行する回数。0 なら再試行しません。"
				},
				"piiGuard.properNouns.modelPath": {
					"type": "string",
					"default": "",
					"description": "モデルの置き場所。空なら ~/.agent/pii-ner を見ます。"
				},
				"piiGuard.properNouns.modelUrl": {
					"type": "string",
					"default": "",
					"description": "モデルの取得先。既定の取得先は持ちません。空なら取得しません。"
				}
			}
		},
		"commands": [
			{
				"command": "piiGuard.checkFile",
				"title": "このファイルの個人情報を確認する",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.maskFile",
				"title": "このファイルの個人情報を伏せる",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.restoreFile",
				"title": "伏せ字を元の値へ戻す",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.addToDictionary",
				"title": "選んだ語を辞書へ足す",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.exportDictionary",
				"title": "辞書を書き出す",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.fetchModel",
				"title": "モデルを取得する",
				"category": "PII Guard"
			},
			{
				"command": "piiGuard.modelStatus",
				"title": "モデルの置き場所を確かめる",
				"category": "PII Guard"
			}
		],
		"menus": {
			"editor/context": [
				{
					"submenu": "piiGuard.editor",
					"group": "9_pii"
				}
			],
			"piiGuard.editor": [
				{
					"command": "piiGuard.checkFile",
					"group": "1_mask@1"
				},
				{
					"command": "piiGuard.maskFile",
					"group": "1_mask@2"
				},
				{
					"command": "piiGuard.restoreFile",
					"group": "1_mask@3"
				},
				{
					"command": "piiGuard.addToDictionary",
					"when": "editorHasSelection",
					"group": "2_dictionary"
				}
			]
		},
		"submenus": [
			{
				"id": "piiGuard.editor",
				"label": "PII Guard"
			}
		]
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"bundle": "node esbuild.mjs",
		"test": "vitest run",
		"vsix": "node package-vsix.mjs universal linux-x64 win32-x64",
		"vscode:prepublish": "node esbuild.mjs --production"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"onnxruntime-node": "^1.23.0",
		"undici": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.95.0",
		"esbuild": "^0.25.0",
		"nock": "^14.0.0",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0",
		"@vscode/vsce": "^3.0.0"
	}
}
